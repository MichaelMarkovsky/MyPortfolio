---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <div class="font-mono text-sm">

    <!-- Header -->
    <div class="mb-8">
      <p class="text-zinc-500 mb-1">~ / about</p>
      <h1 class="text-2xl font-bold text-zinc-100 uppercase tracking-widest">
        Michael Markovsky <span class="text-zinc-500">竜</span>
      </h1>
      <p class="text-zinc-500 text-xs mt-1">Linux · Security · Automation</p>
    </div>

    <!-- Bio -->
    <section class="mb-8">
      <div class="flex items-center gap-2 text-xs text-zinc-500 uppercase tracking-widest mb-3">
        <span class="text-green-400">▸</span>
        <span>whoami</span>
      </div>

      <div class="border-l-2 border-zinc-800 pl-4 text-zinc-400 leading-relaxed space-y-2">
        <p>
          I am obsessed with how things work under the hood — operating systems,
          networks, and the gaps in between. I spend most of my time on Linux,
          writing automation scripts, doing CTFs, and building minimal tools that
          solve real problems.
        </p>

        <p>
          When I'm not at a terminal I'm probably reading about low-level systems,
          contributing to open source, or breaking things intentionally.
        </p>
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-8">
      <div class="flex items-center gap-2 text-xs text-zinc-500 uppercase tracking-widest mb-3">
        <span class="text-green-400">▸</span>
        <span>skills --list</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pl-4">

        <div>
          <p class="text-zinc-500 text-xs uppercase tracking-widest mb-2">
            Languages
          </p>

          <div class="flex flex-wrap gap-2">
            {["Python", "Go", "Bash", "JavaScript"].map(s => (
              <span class="bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs px-2 py-0.5 rounded">
                {s}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="text-zinc-500 text-xs uppercase tracking-widest mb-2">
            Tools
          </p>

          <div class="flex flex-wrap gap-2">
            {["Git", "Docker", "Arch Linux"].map(s => (
              <span class="bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs px-2 py-0.5 rounded">
                {s}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="text-zinc-500 text-xs uppercase tracking-widest mb-2">
            Dev / Automation
          </p>

          <div class="flex flex-wrap gap-2">
            {["Web Scraping", "Selenium / Flask", "API Integration", "FastAPI", "Bot Evasion"].map(s => (
              <span class="bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs px-2 py-0.5 rounded">
                {s}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="text-zinc-500 text-xs uppercase tracking-widest mb-2">
            Security & CTFs
          </p>

          <div class="flex flex-wrap gap-2">
            {["Hack The Box", "TryHackMe", "PortSwigger"].map(s => (
              <span class="bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs px-2 py-0.5 rounded">
                {s}
              </span>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- Experience -->
    <section class="mb-8">
      <div class="flex items-center gap-2 text-xs text-zinc-500 uppercase tracking-widest mb-3">
        <span class="text-green-400">▸</span>
        <span>cat experience.log</span>
      </div>

      <div class="pl-4 space-y-5">

        <div class="border-l-2 border-zinc-800 hover:border-green-400/50 transition-colors pl-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <p class="text-zinc-100 font-medium">Classified</p>
            <span class="text-zinc-600 text-xs whitespace-nowrap">
              2020 – 2023
            </span>
          </div>

          <p class="text-green-400/70 text-xs mb-1">
            Israel Defense Forces
          </p>

          <p class="text-zinc-400 text-xs leading-relaxed">
            Air force - classified
          </p>
        </div>

        <div class="border-l-2 border-zinc-800 hover:border-green-400/50 transition-colors pl-4">
        </div>

      </div>
    </section>

    <!-- Education -->
    <section class="mb-8">
      <div class="flex items-center gap-2 text-xs text-zinc-500 uppercase tracking-widest mb-3">
        <span class="text-green-400">▸</span>
        <span>cat education.log</span>
      </div>

      <div class="pl-4 space-y-5">

        <div class="border-l-2 border-zinc-800 hover:border-green-400/50 transition-colors pl-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <p class="text-zinc-100 font-medium">
              B.Sc. Computer Science
            </p>

            <span class="text-zinc-600 text-xs whitespace-nowrap">
              2024 – present
            </span>
          </div>

          <p class="text-green-400/70 text-xs mb-1">
            SCE College
          </p>

          <p class="text-zinc-400 text-xs leading-relaxed">
            Focus on systems programming, networks, and security.
          </p>
        </div>

      </div>
    </section>

    <!-- Footer prompt -->
    <div class="mt-12 text-zinc-700 text-xs flex items-center gap-2">
      <span class="text-green-400">michael@portfolio</span>
      <span>~</span>
      <span class="animate-pulse">█</span>
    </div>

  </div>
</BaseLayout>


