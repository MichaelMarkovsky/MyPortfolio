---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const grouped = posts.reduce((acc: Record<string, typeof posts>, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Blog">
  <div class="font-mono">

    <div class="mb-4 flex items-center gap-2 text-xs text-zinc-600">
      <span class="text-green-400">michael@portfolio</span>
      <span>~</span>
      <span>$</span>
      <span class="text-zinc-400">ls posts/</span>
    </div>

    <div class="mb-8 flex items-center gap-2 text-xs uppercase tracking-widest text-zinc-500">
      <span class="text-green-400">▸</span>
      <span>all posts</span>
      <span class="ml-2 flex-1 border-t border-zinc-800"></span>
      <span class="text-zinc-700">{posts.length} entries</span>
    </div>

    {years.map((year) => (
      <div class="mb-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="text-xs uppercase tracking-widest text-green-400">{year}</span>
          <span class="flex-1 border-t border-zinc-800/60"></span>
        </div>

        <div class="flex flex-col">
          {grouped[year].map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group grid grid-cols-[130px_1fr] gap-4 items-start py-3 border-b border-zinc-800/40 hover:border-zinc-700 transition-colors no-underline"
            >
              <span class="whitespace-nowrap pt-0.5 text-xs text-zinc-600">
                {post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </span>

              <span class="flex flex-col gap-1">
                <span class="text-sm leading-snug text-zinc-300 transition-colors group-hover:text-green-400">
                  {post.data.title}
                </span>

                <span class="text-xs text-zinc-600 leading-snug group-hover:text-zinc-500 transition-colors">
                  {post.data.description}
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-12 flex items-center gap-2 text-xs text-zinc-700">
      <span class="text-green-400">michael@portfolio</span>
      <span>~</span>
      <span class="animate-pulse">█</span>
    </div>

  </div>
</BaseLayout>
