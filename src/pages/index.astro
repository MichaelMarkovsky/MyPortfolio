---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectsAccordion from "../components/ProjectsAccordion.svelte";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = await getCollection("projects");

const categoryOrder = ["Security", "Linux", "Automation", "Lifestyle", "Projects", "Game Development"];

const groupedProjects = Object.values(
  projects.reduce((acc, project) => {
    const category = project.data.category;
    if (!acc[category]) acc[category] = { category, projects: [] };
    acc[category].projects.push(project);
    return acc;
  }, {})
).sort((a, b) => {
  const ai = categoryOrder.indexOf(a.category);
  const bi = categoryOrder.indexOf(b.category);
  return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});
---

<BaseLayout title="Home">

  <!-- HERO -->
  <section class="mb-16 pt-6 font-mono">
    <div class="text-xs text-zinc-600 mb-4 flex items-center gap-2">
      <span class="text-green-400">michael@portfolio</span>
      <span>~</span>
      <span>$</span>
      <span class="text-zinc-400">whoami</span>
    </div>
    <h1 class="text-3xl font-bold text-zinc-100 tracking-tight mb-1">
      Michael Markovsky
      <span class="text-zinc-600 text-2xl ml-1">竜</span>
    </h1>
    <p class="text-zinc-500 text-xs mb-4 uppercase tracking-widest">
      Linux · Security · Automation
    </p>
    <p class="text-zinc-400 text-sm max-w-lg leading-relaxed border-l-2 border-zinc-800 pl-4">
      I am experienced with Linux, automation, security research, and building minimal software systems.
      Usually found breaking things intentionally or automating something that probably
      didn't need to be automated.
    </p>
    <div class="flex items-center gap-0 mt-6 text-xs text-zinc-600">
      <a href="https://github.com/MichaelMarkovsky" target="_blank" class="hover:text-green-400 transition-colors pr-3">GitHub</a>
      <span>|</span>
      <a href="https://www.linkedin.com/in/michael-markovsky-321ab4257" target="_blank" class="hover:text-green-400 transition-colors px-3">LinkedIn</a>
    </div>
  </section>

  <!-- LATEST POSTS -->
  <section class="mb-16 font-mono">
    <div class="flex items-center gap-2 text-xs text-zinc-500 uppercase tracking-widest mb-5">
      <span class="text-green-400">▸</span>
      <span>latest posts</span>
      <span class="flex-1 border-t border-zinc-800 ml-2"></span>
      <a href="/blog" class="text-zinc-600 hover:text-green-400 transition-colors normal-case tracking-normal">
        view all →
      </a>
    </div>
    <div class="flex flex-col">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="mb-20 font-mono">
    <div class="flex items-center gap-2 text-xs text-zinc-500 uppercase tracking-widest mb-5">
      <span class="text-green-400">▸</span>
      <span>projects</span>
      <span class="flex-1 border-t border-zinc-800 ml-2"></span>
    </div>
    <ProjectsAccordion client:load groups={groupedProjects} />
  </section>

  <!-- Footer prompt -->
  <div class="font-mono text-xs text-zinc-700 flex items-center gap-2 pb-4">
    <span class="text-green-400">michael@portfolio</span>
    <span>~</span>
    <span class="animate-pulse">█</span>
  </div>

</BaseLayout>
